# Postgres já existente na VPS do cliente
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco?sslmode=disable

# Redis (subido via docker-compose, servico "redis")
REDIS_URL=redis://redis:6379

# Autenticacao
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# Chave usada para criptografar segredos sensiveis no banco (ex: API key da IA)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Evolution API (ja existente na VPS do cliente)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# URL publica desta aplicacao (usada em links, callbacks, etc)
APP_BASE_URL=

PORT=3333
NODE_ENV=production

# CORS - origem(s) permitida(s) do frontend, separadas por virgula
CORS_ORIGIN=http://localhost:5173
